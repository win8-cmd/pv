# CENEP 本地环境配置示例
# 复制为 .env 后按需修改；.env 已被 .gitignore 排除，不会提交。
# 第一阶段仅使用 CENEP_DB_PATH 一项，其余为后续阶段预留。

# 本地项目数据库路径（留空则使用 %LOCALAPPDATA%\CENEP\cenep.db）
CENEP_DB_PATH=

# 日志级别：DEBUG / INFO / WARNING / ERROR
CENEP_LOG_LEVEL=INFO

# --- 以下为后续阶段预留，第一阶段代码不会读取 ---
# CENEP_REPORT_OUTPUT_DIR=
# CENEP_TARIFF_SOURCE_ENDPOINT=
# CENEP_TARIFF_SOURCE_TOKEN=
